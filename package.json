{
  "name": "casa-lira",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @casa-lira/contracts build && pnpm db:migrate && pnpm --parallel --filter @casa-lira/api --filter @casa-lira/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @casa-lira/api test",
    "db:generate": "pnpm --filter @casa-lira/api db:generate",
    "db:migrate": "pnpm --filter @casa-lira/api db:migrate",
    "seed": "pnpm db:migrate && pnpm --filter @casa-lira/api seed",
    "test:ui": "node scripts/ui-smoke.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
